# 2) Firestore security rules (exact)

**Principles**

* **Phone (public)** never writes Firestore directly.
* **Cloud Functions (Admin SDK)** writes `spinEvents`, reads `spinTokens`, reads `wheelCampaigns`.
* **Screen device** reads `spinEvents` after it authenticates as a *screen session* (custom token).

Create `firestore.rules` like this:

```rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function orgDoc(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId));
    }

    function isOrgMember(orgId) {
      return signedIn()
        && (request.auth.uid == orgDoc(orgId).data.ownerId
            || request.auth.uid in orgDoc(orgId).data.members);
    }

    // Custom-claims based screen sessions:
    // request.auth.token.role == "screen"
    // request.auth.token.orgId == orgId
    // request.auth.token.screenId == screenId
    function isScreenSession(orgId, screenId) {
      return signedIn()
        && request.auth.token.role == "screen"
        && request.auth.token.orgId == orgId
        && request.auth.token.screenId == screenId;
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow write: if false; // lock root doc edits behind app logic if you want

      match /locations/{locationId} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgMember(orgId);
      }

      match /slides/{slideId} {
        allow read: if isOrgMember(orgId) || request.auth.token.role == "screen" && request.auth.token.orgId == orgId;
        allow write: if isOrgMember(orgId);
      }

      match /screens/{screenId} {
        allow read: if isOrgMember(orgId) || isScreenSession(orgId, screenId);
        allow write: if isOrgMember(orgId);
      }

      match /wheelCampaigns/{campaignId} {
        allow read: if isOrgMember(orgId);   // screens can read via function if needed
        allow write: if isOrgMember(orgId);
      }

      // NEVER allow clients to read tokens directly (prevents QR harvesting).
      match /spinTokens/{tokenId} {
        allow read, write: if false;
      }

      // Spin events:
      // - Org members can read (analytics)
      // - Screen sessions can read events for their screen
      // - No client writes (server only)
      match /spinEvents/{eventId} {
        allow read: if isOrgMember(orgId)
          || (signedIn()
              && request.auth.token.role == "screen"
              && request.auth.token.orgId == orgId
              && resource.data.screenId == request.auth.token.screenId);

        allow create, update, delete: if false; // Admin SDK only
      }
    }
  }
}
```

