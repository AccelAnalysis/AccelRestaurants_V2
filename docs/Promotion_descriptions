# 5) Phone-side “Spin” page (minimal)

Your QR points to a page like `/spin?t=tokenId&o=orgId`. The page calls `createSpin`.

```tsx
import React, { useMemo, useState } from "react";
import { httpsCallable } from "firebase/functions";
import { functions } from "./firebase";

export function SpinPage() {
  const [status, setStatus] = useState<"ready"|"spinning"|"done"|"error">("ready");
  const [result, setResult] = useState<any>(null);

  const params = new URLSearchParams(window.location.search);
  const orgId = params.get("o") || "";
  const tokenId = params.get("t") || "";

  const fingerprint = useMemo(() => {
    // Lightweight; you can improve later
    return `${navigator.userAgent}|${Date.now() - (Date.now() % 60000)}`; // changes per minute
  }, []);

  async function spin() {
    setStatus("spinning");
    try {
      const fn = httpsCallable(functions, "createSpin");
      const res: any = await fn({ orgId, tokenId, fingerprint });
      setResult(res.data);
      setStatus("done");
    } catch (e) {
      console.error(e);
      setStatus("error");
    }
  }

  return (
    <div style={{ padding: 20, fontFamily: "Inter, system-ui" }}>
      <h1>Spin & Win</h1>
      {status === "ready" && <button onClick={spin}>SPIN</button>}
      {status === "spinning" && <div>Spinning on the big screen…</div>}
      {status === "done" && <div>Nice! Look up at the screen.</div>}
      {status === "error" && <div>Sorry—try again in a moment.</div>}
    </div>
  );
}
```

