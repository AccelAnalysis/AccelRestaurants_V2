# 3) Cloud Functions flow (exact)

You need **three** functions:

1. `getScreenSession` — Display device exchanges `screenKey` for a **Firebase custom token** (with claims).
2. `createSpin` — Phone requests spin using `orgId + tokenId`; server resolves prize + creates event.
3. `markSpinDisplayed` — Screen marks the event displayed (so next queued event appears).

### `functions/src/index.ts` (TypeScript)

```ts
import * as admin from "firebase-admin";
import * as functions from "firebase-functions";
import * as crypto from "crypto";

admin.initializeApp();
const db = admin.firestore();

/** Helpers */
function sha256(input: string) {
  return crypto.createHash("sha256").update(input).digest("hex");
}

function randomCode(len = 6) {
  const alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"; // no O/0/I/1
  let out = "";
  for (let i = 0; i < len; i++) out += alphabet[Math.floor(Math.random() * alphabet.length)];
  return out;
}

function weightedPick<T extends { weight: number }>(items: T[]) {
  const total = items.reduce((s, x) => s + Math.max(0, x.weight), 0);
  let r = Math.random() * total;
  for (const it of items) {
    r -= Math.max(0, it.weight);
    if (r <= 0) return it;
  }
  return items[items.length - 1];
}

/**
 * 1) DISPLAY: exchange screenKey for custom token with claims
 * Call this once on display boot.
 */
export const getScreenSession = functions.https.onCall(async (data, context) => {
  const { orgId, screenId, screenKey } = data ?? {};
  if (!orgId || !screenId || !screenKey) throw new functions.https.HttpsError("invalid-argument", "Missing orgId/screenId/screenKey.");

  const screenRef = db.doc(`organizations/${orgId}/screens/${screenId}`);
  const screenSnap = await screenRef.get();
  if (!screenSnap.exists) throw new functions.https.HttpsError("not-found", "Screen not found.");

  const screen = screenSnap.data()!;
  const providedHash = sha256(String(screenKey));
  if (providedHash !== screen.screenKeyHash) {
    throw new functions.https.HttpsError("permission-denied", "Invalid screenKey.");
  }

  // Create a UID for screen sessions (stable per screen)
  const uid = `screen:${orgId}:${screenId}`;

  const token = await admin.auth().createCustomToken(uid, {
    role: "screen",
    orgId,
    screenId,
  });

  await screenRef.update({ lastSeenAt: admin.firestore.FieldValue.serverTimestamp() });

  return { token };
});


/**
 * 2) PHONE: request spin (public)
 * - Validates token
 * - Rate limits by fingerprintHash (IP+UA hash passed from client; can also use callable context.rawRequest IP)
 * - Resolves prize server-side
 * - Writes spinEvents doc
 */
export const createSpin = functions.https.onCall(async (data, context) => {
  const { orgId, tokenId, fingerprint } = data ?? {};
  if (!orgId || !tokenId) throw new functions.https.HttpsError("invalid-argument", "Missing orgId/tokenId.");

  // fingerprint can be generated client-side, but do NOT store raw; hash it
  const fpHash = sha256(String(fingerprint || "unknown"));

  const tokenRef = db.doc(`organizations/${orgId}/spinTokens/${tokenId}`);
  const tokenSnap = await tokenRef.get();
  if (!tokenSnap.exists) throw new functions.https.HttpsError("permission-denied", "Invalid token.");

  const token = tokenSnap.data()!;
  if (!token.enabled) throw new functions.https.HttpsError("failed-precondition", "Spin token disabled.");
  if (token.expiresAt?.toDate && token.expiresAt.toDate() < new Date()) {
    throw new functions.https.HttpsError("failed-precondition", "Spin token expired.");
  }

  const { screenId, locationId, campaignId } = token;

  const campaignRef = db.doc(`organizations/${orgId}/wheelCampaigns/${campaignId}`);
  const campaignSnap = await campaignRef.get();
  if (!campaignSnap.exists) throw new functions.https.HttpsError("failed-precondition", "Campaign not found.");

  const campaign = campaignSnap.data()!;
  if (!campaign.enabled) throw new functions.https.HttpsError("failed-precondition", "Campaign disabled.");

  // Optional campaign window
  const now = new Date();
  if (campaign.startAt?.toDate && campaign.startAt.toDate() > now) throw new functions.https.HttpsError("failed-precondition", "Campaign not started.");
  if (campaign.endAt?.toDate && campaign.endAt.toDate() < now) throw new functions.https.HttpsError("failed-precondition", "Campaign ended.");

  // Optional screen allowlist
  if (Array.isArray(campaign.allowedScreenIds) && campaign.allowedScreenIds.length > 0) {
    if (!campaign.allowedScreenIds.includes(screenId)) throw new functions.https.HttpsError("permission-denied", "Screen not allowed.");
  }

  // Rate limit: 1 spin per fingerprint per 30s (tune)
  const rlRef = db.doc(`organizations/${orgId}/_rateLimits/spin:${fpHash}`);
  const eventRef = db.collection(`organizations/${orgId}/spinEvents`).doc();

  const result = await db.runTransaction(async (tx) => {
    const rlSnap = await tx.get(rlRef);
    const last = rlSnap.exists ? rlSnap.data()!.lastSpinAt?.toDate?.() : null;
    if (last && (now.getTime() - last.getTime()) < 30_000) {
      throw new functions.https.HttpsError("resource-exhausted", "Too many spins. Please wait a moment.");
    }

    // Filter prizes: enabled & inventory available (if inventory is number)
    const prizes = Array.isArray(campaign.prizes) ? campaign.prizes : [];
    const available = prizes
      .map((p: any, idx: number) => ({ ...p, _index: idx }))
      .filter((p: any) => p.enabled !== false)
      .filter((p: any) => p.inventory == null || p.inventory > 0)
      .filter((p: any) => typeof p.weight === "number" && p.weight > 0);

    if (available.length === 0) {
      throw new functions.https.HttpsError("failed-precondition", "No prizes available.");
    }

    const picked: any = weightedPick(available);
    const prizeIndex = picked._index;

    // If limited inventory, decrement it inside campaign doc (transaction)
    // Note: updating nested array element requires rewriting prizes array
    if (picked.inventory != null) {
      const newPrizes = prizes.slice();
      const cur = { ...newPrizes[prizeIndex] };
      cur.inventory = Math.max(0, (cur.inventory || 0) - 1);
      newPrizes[prizeIndex] = cur;
      tx.update(campaignRef, { prizes: newPrizes, updatedAt: admin.firestore.FieldValue.serverTimestamp() });
    }

    const code = randomCode(6);

    // Determine target angle so wheel lands on prizeIndex
    //  - We assume N segments, each segment = 360/N
    //  - Add multiple full rotations + small jitter inside the segment
    const n = prizes.length;
    const seg = 360 / Math.max(1, n);

    // pointer at top (0deg). we rotate wheel so that the center of the target segment ends at 0deg.
    const centerOfSegment = (prizeIndex * seg) + seg / 2;
    const jitter = (Math.random() * (seg * 0.6)) - (seg * 0.3); // +/- 30% of seg
    const targetDeg = (360 * 6) + (360 - centerOfSegment) + jitter; // 6 spins then settle

    const expiresAt =
      picked.expiresMinutes != null
        ? admin.firestore.Timestamp.fromDate(new Date(now.getTime() + picked.expiresMinutes * 60_000))
        : null;

    // TTL: purge events after 2 days
    const expireAt = admin.firestore.Timestamp.fromDate(new Date(now.getTime() + 2 * 24 * 60 * 60_000));

    tx.set(eventRef, {
      orgId,
      locationId,
      screenId,
      campaignId,
      tokenId,
      fingerprintHash: fpHash,
      requestedAt: admin.firestore.FieldValue.serverTimestamp(),
      resolvedAt: admin.firestore.FieldValue.serverTimestamp(),
      displayedAt: null,
      redeemedAt: null,
      result: {
        prizeId: picked.id,
        label: picked.label,
        code,
        prizeIndex,
        targetDeg,
        expiresAt,
      },
      expireAt,
    });

    tx.set(rlRef, { lastSpinAt: admin.firestore.FieldValue.serverTimestamp() }, { merge: true });

    return { eventId: eventRef.id, label: picked.label, code, prizeIndex, targetDeg, expiresAt };
  });

  return result;
});


/**
 * 3) DISPLAY: mark event displayed (screen session only)
 */
export const markSpinDisplayed = functions.https.onCall(async (data, context) => {
  const { orgId, eventId } = data ?? {};
  if (!orgId || !eventId) throw new functions.https.HttpsError("invalid-argument", "Missing orgId/eventId.");

  // Must be screen session
  const claims: any = context.auth?.token;
  if (!claims || claims.role !== "screen" || claims.orgId !== orgId) {
    throw new functions.https.HttpsError("permission-denied", "Not a screen session.");
  }

  const eventRef = db.doc(`organizations/${orgId}/spinEvents/${eventId}`);
  const snap = await eventRef.get();
  if (!snap.exists) throw new functions.https.HttpsError("not-found", "Event not found.");

  const ev = snap.data()!;
  if (ev.screenId !== claims.screenId) {
    throw new functions.https.HttpsError("permission-denied", "Wrong screen.");
  }

  await eventRef.update({
    displayedAt: admin.firestore.FieldValue.serverTimestamp(),
  });

  return { ok: true };
});
```

