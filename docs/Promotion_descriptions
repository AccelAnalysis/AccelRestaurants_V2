# 4) React implementation

## A) PrizeWheelOverlay component (Tailwind + deterministic landing)

Create `PrizeWheelOverlay.tsx`:

```tsx
import React, { useEffect, useMemo, useRef, useState } from "react";

type WheelPrize = { label: string };
type WheelEvent = {
  id: string;
  result: {
    label: string;
    code: string;
    prizeIndex: number;
    targetDeg: number;
  };
  campaign: {
    spinMs: number;
    settleMs: number;
    prizes: WheelPrize[];
  };
};

export function PrizeWheelOverlay({
  event,
  onFinished,
}: {
  event: WheelEvent | null;
  onFinished: () => void;
}) {
  const [phase, setPhase] = useState<"idle" | "spinning" | "revealed">("idle");
  const wheelRef = useRef<HTMLDivElement | null>(null);

  const prizes = event?.campaign.prizes ?? [];
  const spinMs = event?.campaign.spinMs ?? 5200;
  const settleMs = event?.campaign.settleMs ?? 800;

  const background = useMemo(() => {
    // Conic gradient segments. Keep colors subtle; you can theme later.
    // If you want brand colors, replace these with your palette.
    const n = Math.max(1, prizes.length);
    const stops: string[] = [];
    for (let i = 0; i < n; i++) {
      const a0 = (i / n) * 100;
      const a1 = ((i + 1) / n) * 100;
      const c = i % 2 === 0 ? "rgba(255,255,255,0.10)" : "rgba(255,255,255,0.18)";
      stops.push(`${c} ${a0}% ${a1}%`);
    }
    return `conic-gradient(from -90deg, ${stops.join(",")})`;
  }, [prizes.length]);

  useEffect(() => {
    if (!event) {
      setPhase("idle");
      if (wheelRef.current) wheelRef.current.style.transform = `rotate(0deg)`;
      return;
    }

    // Trigger spin once per event
    setPhase("spinning");

    const el = wheelRef.current;
    if (el) {
      el.style.transition = "none";
      el.style.transform = "rotate(0deg)";
      // next frame
      requestAnimationFrame(() => {
        if (!wheelRef.current) return;
        wheelRef.current.style.transition = `transform ${spinMs}ms cubic-bezier(0.12, 0.8, 0.12, 1)`;
        wheelRef.current.style.transform = `rotate(${event.result.targetDeg}deg)`;
      });
    }

    const t1 = window.setTimeout(() => setPhase("revealed"), spinMs + settleMs);
    const t2 = window.setTimeout(() => onFinished(), spinMs + settleMs + 3500);

    return () => {
      window.clearTimeout(t1);
      window.clearTimeout(t2);
    };
  }, [event?.id]);

  if (!event) return null;

  const n = Math.max(1, prizes.length);
  const seg = 360 / n;

  return (
    <div className="fixed inset-0 z-[1000] flex items-center justify-center">
      {/* Backdrop */}
      <div className="absolute inset-0 bg-black/70 backdrop-blur-sm" />

      <div className="relative w-[720px] max-w-[92vw]">
        {/* Header */}
        <div className="text-center mb-6">
          <div className="text-white text-4xl font-extrabold tracking-tight">
            Spin &amp; Win
          </div>
          <div className="text-white/70 mt-1">
            Watch the screen for your prize
          </div>
        </div>

        {/* Wheel + pointer */}
        <div className="relative mx-auto w-[520px] h-[520px] max-w-[92vw] max-h-[92vw]">
          {/* Pointer */}
          <div className="absolute left-1/2 -translate-x-1/2 -top-3 z-20">
            <div className="w-0 h-0 border-l-[18px] border-r-[18px] border-b-[32px] border-l-transparent border-r-transparent border-b-orange-500 drop-shadow" />
          </div>

          {/* Outer ring */}
          <div className="absolute inset-0 rounded-full bg-white/10 ring-2 ring-white/15 shadow-2xl" />

          {/* Wheel */}
          <div
            ref={wheelRef}
            className="absolute inset-[18px] rounded-full overflow-hidden"
            style={{ background }}
          >
            {/* Labels */}
            {prizes.map((p, i) => {
              const rot = i * seg + seg / 2; // middle of segment
              return (
                <div
                  key={`${p.label}-${i}`}
                  className="absolute left-1/2 top-1/2 origin-[0%_0%]"
                  style={{
                    transform: `rotate(${rot}deg) translate(0, -220px)`,
                  }}
                >
                  <div
                    className="text-white text-sm font-semibold whitespace-nowrap"
                    style={{ transform: `rotate(90deg)` }} // keep text roughly radial
                  >
                    {p.label}
                  </div>
                </div>
              );
            })}

            {/* Center cap */}
            <div className="absolute left-1/2 top-1/2 w-28 h-28 -translate-x-1/2 -translate-y-1/2 rounded-full bg-neutral-950/80 ring-2 ring-white/15 flex items-center justify-center">
              <div className="text-white font-bold text-sm">
                {phase === "spinning" ? "SPINNING" : "WINNER"}
              </div>
            </div>
          </div>
        </div>

        {/* Prize reveal */}
        <div className="mt-8 text-center">
          {phase !== "revealed" ? (
            <div className="text-white/80 text-xl font-semibold">
              Spinning...
            </div>
          ) : (
            <div className="bg-white/10 ring-1 ring-white/15 rounded-2xl p-6">
              <div className="text-white text-2xl font-extrabold">
                You won: {event.result.label}
              </div>
              <div className="text-white/70 mt-2">
                Show this code to the cashier:
              </div>
              <div className="mt-3 inline-flex px-6 py-3 rounded-xl bg-black/40 ring-1 ring-white/15 text-white text-3xl font-black tracking-widest">
                {event.result.code}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
```

## B) Wire it into your current `DisplayPlayer`

Your current `DisplayPlayer` is this shape (slides loop). We’ll add:

* A **screen session sign-in** on boot (`getScreenSession`)
* A **Firestore listener** that pulls the next undisplayed spin event
* The overlay that plays and then calls `markSpinDisplayed`

### Modified `DisplayPlayer` (drop-in replacement)

```tsx
import React, { useEffect, useMemo, useRef, useState } from "react";
import { onSnapshot, collection, query, where, orderBy, limit, doc, getDoc } from "firebase/firestore";
import { httpsCallable } from "firebase/functions";
import { signInWithCustomToken } from "firebase/auth";

import { db, functions, auth } from "./firebase"; // <-- your firebase init exports
import { PrizeWheelOverlay } from "./PrizeWheelOverlay";

type SpinEventDoc = {
  id: string;
  screenId: string;
  campaignId: string;
  resolvedAt: any;
  displayedAt: any | null;
  result: {
    label: string;
    code: string;
    prizeIndex: number;
    targetDeg: number;
  };
};

function DisplayPlayer({ screen, allSlides, onExit, orgId, screenKey }: any) {
  const [currentIndex, setCurrentIndex] = useState(0);
  const [wheelEvent, setWheelEvent] = useState<any | null>(null);
  const [campaignCache, setCampaignCache] = useState<any | null>(null);
  const busyRef = useRef(false);

  const slidesToPlay = useMemo(
    () => screen.slides.map((id: string) => allSlides.find((s: any) => s.id === id)).filter(Boolean),
    [screen.slides, allSlides]
  );
  const currentSlide = slidesToPlay[currentIndex];

  // Slide rotation (your existing logic)
  useEffect(() => {
    if (slidesToPlay.length <= 1) return;
    const interval = setInterval(
      () => setCurrentIndex((prev) => (prev + 1) % slidesToPlay.length),
      screen.rotation || 10000
    );
    return () => clearInterval(interval);
  }, [screen.rotation, slidesToPlay.length]);

  // 1) Display device: authenticate as screen session using screenKey
  useEffect(() => {
    let cancelled = false;

    async function boot() {
      if (!orgId || !screen?.id || !screenKey) return;

      const getSession = httpsCallable(functions, "getScreenSession");
      const res: any = await getSession({ orgId, screenId: screen.id, screenKey });
      if (cancelled) return;

      await signInWithCustomToken(auth, res.data.token);
    }

    boot().catch(console.error);
    return () => {
      cancelled = true;
    };
  }, [orgId, screen?.id, screenKey]);

  // 2) Listen for next undisplayed spin event for this screen
  useEffect(() => {
    if (!orgId || !screen?.id) return;
    if (!screen.wheelEnabled || !screen.activeWheelCampaignId) return;

    // Queue behavior: oldest resolved, not displayed yet
    const q = query(
      collection(db, `organizations/${orgId}/spinEvents`),
      where("screenId", "==", screen.id),
      where("displayedAt", "==", null),
      orderBy("resolvedAt", "asc"),
      limit(1)
    );

    const unsub = onSnapshot(
      q,
      async (snap) => {
        if (busyRef.current) return;
        if (snap.empty) return;

        const docSnap = snap.docs[0];
        const ev = { id: docSnap.id, ...(docSnap.data() as any) } as SpinEventDoc;

        // Load campaign config (cached)
        let campaign = campaignCache;
        if (!campaign || campaign._id !== ev.campaignId) {
          const cRef = doc(db, `organizations/${orgId}/wheelCampaigns/${ev.campaignId}`);
          const cSnap = await getDoc(cRef);
          if (!cSnap.exists()) return;
          campaign = { _id: cSnap.id, ...(cSnap.data() as any) };
          setCampaignCache(campaign);
        }

        busyRef.current = true;
        setWheelEvent({
          id: ev.id,
          result: ev.result,
          campaign: {
            spinMs: campaign.spinMs ?? 5200,
            settleMs: campaign.settleMs ?? 800,
            prizes: (campaign.prizes ?? []).map((p: any) => ({ label: p.label })),
          },
        });
      },
      console.error
    );

    return () => unsub();
  }, [orgId, screen?.id, screen?.wheelEnabled, screen?.activeWheelCampaignId, campaignCache]);

  // 3) After overlay finishes, mark displayed and clear
  async function handleWheelFinished() {
    try {
      if (!orgId || !wheelEvent?.id) return;
      const mark = httpsCallable(functions, "markSpinDisplayed");
      await mark({ orgId, eventId: wheelEvent.id });
    } catch (e) {
      console.error(e);
    } finally {
      setWheelEvent(null);
      busyRef.current = false;
    }
  }

  if (!currentSlide) {
    return (
      <div className="fixed inset-0 bg-black flex flex-col items-center justify-center text-white">
        <h1 className="text-4xl font-bold mb-4">No Signal</h1>
        <button onClick={onExit} className="mt-8 px-4 py-2 bg-neutral-800 rounded">
          Exit
        </button>
      </div>
    );
  }

  return (
    <div className="fixed inset-0 bg-black overflow-hidden cursor-none">
      <div className="w-full h-full relative" style={{ backgroundColor: currentSlide.background }}>
        {currentSlide.elements
          .sort((a: any, b: any) => a.zIndex - b.zIndex)
          .map((el: any) => (
            <RndElement key={el.id} data={el} isSelected={false} onMouseDown={null} />
          ))}
      </div>

      {/* Wheel overlay */}
      <PrizeWheelOverlay event={wheelEvent} onFinished={handleWheelFinished} />

      <div
        onClick={onExit}
        className="fixed bottom-0 right-0 w-16 h-16 opacity-0 hover:opacity-10 z-50 cursor-pointer flex items-center justify-center bg-white transition-opacity"
      >
        <span className="text-black font-bold text-xs">EXIT</span>
      </div>
    </div>
  );
}
```

### What you pass to DisplayPlayer now

* `orgId` (from your app routing)
* `screenKey` (only on the display device URL; not in customer-facing QR)

Example display URL:
`https://app.accelrestaurants.com/board?org=abc&screen=screen1&key=DISPLAY_SECRET`

